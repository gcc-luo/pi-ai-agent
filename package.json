{
  "name": "pi-web-ui",
  "private": true,
  "version": "0.0.1",
  "scripts": {
    "dev": "pnpm -r --parallel run dev",
    "start": "node scripts/start-dev.mjs",
    "stop": "node scripts/stop-dev.mjs",
    "release:prepare": "node scripts/prepare-release-version.mjs",
    "prepare": "node scripts/setup-git-hooks.mjs",
    "build": "pnpm -r run build",
    "test": "pnpm -r run test",
    "typecheck": "pnpm -r run typecheck",
    "lint": "pnpm -r run lint"
  },
  "devDependencies": {
    "@types/node": "20.14.10",
    "prettier": "3.3.3",
    "typescript": "5.5.4"
  },
  "packageManager": "pnpm@9.6.0",
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "patchedDependencies": {
      "@amaster.ai/pi-channels@0.1.6": "patches/@amaster.ai__pi-channels@0.1.6.patch",
      "@earendil-works/pi-coding-agent@0.82.1": "patches/@earendil-works__pi-coding-agent@0.82.1.patch"
    }
  }
}
