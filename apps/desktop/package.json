{
  "name": "@pi-web-ui/desktop",
  "productName": "PI-AI-Agent",
  "version": "1.4.12",
  "description": "PI AI Agent 桌面客户端",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "pnpm prepare-shell-runtime && pnpm prepare-sidecar && tauri build",
    "build:debug": "pnpm prepare-shell-runtime && pnpm prepare-sidecar && tauri build --debug",
    "test": "node --test scripts/*.test.mjs",
    "typecheck": "vue-tsc --noEmit",
    "tauri": "tauri",
    "prepare-sidecar": "node scripts/prepare-sidecar.mjs",
    "prepare-shell-runtime": "node scripts/prepare-shell-runtime.mjs",
    "verify-release-version": "node scripts/verify-release-version.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.3",
    "@tauri-apps/plugin-fs": "^2.7.1",
    "@tauri-apps/plugin-notification": "^2.7.0",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-shell": "^2.5.0",
    "@tauri-apps/plugin-store": "^2.5.0",
    "@tauri-apps/plugin-updater": "^2.14.0",
    "@tauri-apps/plugin-window-state": "^2.5.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.3",
    "@vitejs/plugin-vue": "^5.0.5",
    "typescript": "^5.5.4",
    "vite": "^5.3.3",
    "vue": "^3.4.31",
    "vue-tsc": "^2.0.26"
  }
}
