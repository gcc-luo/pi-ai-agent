{
  "$schema": "https://schema.tauri.app/config/2",
  "identifier": "default",
  "description": "Default capabilities for the PI AI Agent",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "shell:allow-open",
    "shell:allow-execute",
    "shell:allow-kill",
    "shell:allow-stdin-write",
    "dialog:default",
    "notification:default",
    "fs:default",
    "process:default",
    "store:default",
    "window-state:default"
  ]
}
