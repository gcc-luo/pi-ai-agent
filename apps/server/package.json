    "@fastify/websocket": "11.3.0",
    "@nut-tree-fork/nut-js": "4.2.6",
    "@pi-web-ui/shared": "workspace:*",
    "@wechatbot/wechatbot": "2.2.0",
    "adm-zip": "0.6.0",
    "better-sqlite3": "12.4.1",
    "croner": "10.0.1",
    "dotenv": "17.4.2",
    "fastify": "5.10.0",
    "mammoth": "1.12.0",
    "marked": "18.0.6",
    "node-pty": "1.1.0",
    "nodejieba": "3.5.8",
    "pino": "9.3.2",
    "pino-pretty": "11.2.2",
