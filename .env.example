# ─── Server ───
PORT=5174
HOST=127.0.0.1
LOG_LEVEL=info
# LOG_FILE=~/.pi-web-ui/logs/server.log

# ─── LLM Provider ───
# Required: set at least one API key for the LLM provider
# Supported providers: google, openai, anthropic, openrouter
PI_PROVIDER=google
PI_MODEL=

# Google Gemini (default provider)
GOOGLE_API_KEY=

# OpenAI
# PI_PROVIDER=openai
# PI_MODEL=gpt-4o
# OPENAI_API_KEY=

# Anthropic
# PI_PROVIDER=anthropic
# PI_MODEL=claude-sonnet-4-20250514
# ANTHROPIC_API_KEY=

# OpenRouter
# PI_PROVIDER=openrouter
# PI_MODEL=anthropic/claude-sonnet-4-20250514
# OPENROUTER_API_KEY=

# ─── Agent Process ───
# PI_COMMAND=npx
# PI_ARGS=-y @earendil-works/pi-coding-agent --mode rpc

# ─── Timeouts ───
# IDLE_TIMEOUT_MS=300000
# SUSPENDED_TIMEOUT_MS=1800000
# NO_RESPONSE_TIMEOUT_MS=30000
