# ─── Server ───
PORT=8080
HOST=127.0.0.1
# Required when HOST is not a loopback address. The web client must expose the
# same value as VITE_PI_WEB_UI_AUTH_TOKEN when connecting remotely.
PI_WEB_UI_AUTH_TOKEN=
# VITE_PI_WEB_UI_AUTH_TOKEN=  # set in the web/desktop build environment
LOG_LEVEL=info
# LOG_FILE=~/.pi-web-ui/logs/server.log
# PI_BACKUP_DIR=~/.pi-web-ui/backups

# ─── LLM Provider ───
# Required: set at least one API key for the LLM provider
# Supported providers: google, openai, anthropic, openrouter
PI_PROVIDER=google
PI_MODEL=
# 自动在上下文接近模型窗口上限时压缩旧对话（默认开启）
PI_AUTO_COMPACTION=true

# Google Gemini (default provider)
GOOGLE_API_KEY=

# OpenAI
# PI_PROVIDER=openai
# PI_MODEL=gpt-4o
# OPENAI_API_KEY=

# Anthropic
# PI_PROVIDER=anthropic
# PI_MODEL=claude-sonnet-4-20250514
# ANTHROPIC_API_KEY=

# OpenRouter
# PI_PROVIDER=openrouter
# PI_MODEL=anthropic/claude-sonnet-4-20250514
# OPENROUTER_API_KEY=

# ─── Agent Process ───
# PI_COMMAND=npx
# PI_ARGS=-y @earendil-works/pi-coding-agent --mode rpc

# ─── Browser Use ───
# 默认允许公网和 localhost，阻止局域网、链路本地及云元数据地址。
# 仅在明确需要访问可信内网时开启。
# PI_BROWSER_ALLOW_PRIVATE_NETWORK=false
# PI_BROWSER_HEADLESS=false

# ─── Timeouts ───
# IDLE_TIMEOUT_MS=300000
# SUSPENDED_TIMEOUT_MS=1800000
# NO_RESPONSE_TIMEOUT_MS=30000
